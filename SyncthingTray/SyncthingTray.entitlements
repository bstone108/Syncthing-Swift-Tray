<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Developer ID tray app: not App Sandboxed. Network, Process/launchd,
	     Application Support, and SMAppService use unsandboxed defaults.
	     Hardened Runtime needs JIT for the embedded Syncthing WKWebView. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
