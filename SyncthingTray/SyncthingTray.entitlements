<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Developer ID tray app: not App Sandboxed. Network, Process/launchd,
	     Application Support, and SMAppService use unsandboxed defaults.
	     Hardened Runtime needs JIT for the embedded Syncthing WKWebView.
	     Sparkle 2 is re-signed with the same Developer ID, so library
	     validation stays enabled (no disable-library-validation). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
